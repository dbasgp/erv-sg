---
const nav = [
  { href: '/products/', label: 'Products' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/applications/', label: 'Applications' },
  { href: '/professionals/', label: 'For professionals' },
  { href: '/learn/', label: 'Learn' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="erv.sg home">
      <span class="brand-mark">erv<span class="brand-dot">.</span>sg</span>
      <span class="brand-by">DBA Electric · Singapore</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <a class="btn btn--quiet quote" href="/contact/#quote">Request a quote</a>
    </nav>

    <details class="nav-mobile">
      <summary aria-label="Menu"><span class="burger" aria-hidden="true"></span><span class="label">Menu</span></summary>
      <nav aria-label="Main (mobile)">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--paper) 94%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: var(--space-5); }

  .brand { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); line-height: 1.05; min-height: var(--tap); justify-content: center; font-family: var(--font-sans); }
  .brand-mark { font-weight: 600; font-size: 1.25rem; letter-spacing: -0.02em; }
  .brand-dot { color: var(--wet); }
  .brand-by { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-2); letter-spacing: 0.04em; margin-top: 2px; }

  .nav-desktop { display: none; align-items: center; gap: var(--space-5); }
  .nav-desktop ul { display: flex; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  .nav-desktop li { margin: 0; }
  .nav-desktop ul a {
    display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 0.7rem;
    color: var(--ink); text-decoration: none; font-family: var(--font-sans); font-weight: 400; font-size: 0.95rem;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  .nav-desktop ul a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 0.35em; }
  .nav-desktop ul a[aria-current='page'] { border-bottom-color: var(--rule); }

  .quote { font-family: var(--font-sans); }

  .nav-mobile summary { list-style: none; display: flex; align-items: center; gap: var(--space-2); min-height: var(--tap); min-width: var(--tap); padding: 0 var(--space-2); cursor: pointer; font-family: var(--font-sans); }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .burger, .burger::before, .burger::after { display: block; width: 18px; height: 2px; background: var(--ink); position: relative; }
  .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
  .burger::before { top: -6px; } .burger::after { top: 6px; }
  .nav-mobile[open] .burger { background: transparent; }
  .nav-mobile[open] .burger::before { top: 0; transform: rotate(45deg); }
  .nav-mobile[open] .burger::after { top: 0; transform: rotate(-45deg); }
  .nav-mobile nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--rule); padding: var(--space-2) var(--gutter) var(--space-5); }
  .nav-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-mobile li { margin: 0; border-bottom: 1px solid var(--line); }
  .nav-mobile li a { display: flex; align-items: center; min-height: 52px; color: var(--ink); text-decoration: none; font-family: var(--font-sans); font-size: 1.05rem; }
  .nav-mobile li a[aria-current='page'] { border-left: 3px solid var(--rule); padding-left: 10px; }

  @media (min-width: 70rem) {
    .nav-desktop { display: flex; }
    .nav-mobile { display: none; }
  }
</style>
