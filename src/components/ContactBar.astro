---
import { waHref } from '../config/site';
interface Props { message: string }
const { message } = Astro.props;
const wa = waHref(message);
---
<div class="contact-bar" role="complementary" aria-label="Quick contact">
  <a class="btn quote" href="/contact/#quote">Request a quote</a>
  <a class="btn btn--quiet wa" href={wa} target="_blank" rel="noopener" data-wa="sticky">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3Z"/></svg>
    <span>WhatsApp</span>
  </a>
</div>

<style>
  .contact-bar {
    position: fixed; z-index: 50; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);
    padding: var(--space-2) var(--gutter) calc(var(--space-2) + env(safe-area-inset-bottom));
    background: var(--bg); border-top: 1px solid var(--line);
  }
  .wa { background: var(--surface); }
  @media (min-width: 48rem) {
    .contact-bar { left: auto; right: var(--space-5); bottom: var(--space-5); display: block; padding: 0; background: none; border: 0; }
    .quote { display: none; }
    .wa { box-shadow: 0 6px 20px rgb(0 0 0 / 0.12); border-color: var(--line); }
  }
</style>
