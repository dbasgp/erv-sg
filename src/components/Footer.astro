---
import { site, telHref } from '../config/site';
import { families } from '../data/families';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="col about">
      <p class="brand-mark">erv<span>.sg</span></p>
      <p class="muted small">Ceiling dehumidifiers, fresh-air dehumidifiers and ERV systems for Singapore.</p>
      <p class="small">
        {site.company.legalName}<br />
        UEN {site.company.uen}<br />
        {site.company.street}, {site.company.city} {site.company.postalCode}
      </p>
    </div>
    <nav class="col" aria-label="Products">
      <h2>Products</h2>
      <ul>{families.map((f) => <li><a href={`/products/${f.slug}/`}>{f.name}</a></li>)}</ul>
    </nav>
    <nav class="col" aria-label="Information">
      <h2>Information</h2>
      <ul>
        <li><a href="/how-it-works/">How it works</a></li>
        <li><a href="/applications/">Applications</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/professionals/">For professionals</a></li>
        <li><a href="/learn/">Learn</a></li>
        <li><a href="/faq/">FAQ</a></li>
      </ul>
    </nav>
    <div class="col">
      <h2>Contact</h2>
      <ul>
        <li><a href={telHref()}>{site.contact.phone}</a></li>
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a href="/contact/">Contact page</a></li>
        <li><a href={site.sister.store.url} rel="noopener">Shop at {site.sister.store.name}</a></li>
        <li><a href={site.sister.hk.url} rel="noopener">Hong Kong: {site.sister.hk.name}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal small">
    <p>© {year} {site.company.legalName}</p>
    <ul>
      <li><a href="/about/">About</a></li>
      <li><a href="/safety-compliance/">Safety & compliance</a></li>
      <li><a href="/privacy/">Privacy policy</a></li>
      <li><a href="/terms/">Terms</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--surface); margin-top: var(--space-8); padding-top: var(--space-7); }
  .grid { display: grid; gap: var(--space-6); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 64rem) { .grid { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; } }
  h2 { font-size: var(--step-0); margin-bottom: var(--space-3); }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin: 0; }
  .col a { display: inline-flex; align-items: center; min-height: 36px; color: var(--ink); text-decoration: none; font-size: var(--step--1); }
  .col a:hover { color: var(--accent); text-decoration: underline; }
  .brand-mark { font-weight: 600; font-size: 1.3rem; letter-spacing: -0.03em; margin-bottom: var(--space-2); }
  .brand-mark span { color: var(--accent); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); border-top: 1px solid var(--line); margin-top: var(--space-7); padding-block: var(--space-5) 7rem; color: var(--muted); }
  .legal p { margin: 0; }
  .legal ul { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .legal a { color: var(--muted); display: inline-flex; min-height: var(--tap); align-items: center; }
  @media (min-width: 48rem) { .legal { padding-bottom: var(--space-6); } }
</style>
