---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { productImage } from '../data/images';
interface Props { products: CollectionEntry<'products'>[] }
const { products } = Astro.props;
---
<ul class="prows">
  {products.map((p) => {
    const img = productImage(p.data.images[0]);
    return (
      <li>
        <a href={`/products/${p.data.family}/${p.data.slug}/`}>
          <div class="ph">
            {img
              ? <Image src={img} alt={`${p.data.model} ${p.data.series} series unit`} widths={[160, 320]} sizes="120px" width={160} height={160} />
              : <span class="noimg" aria-hidden="true">photo pending</span>}
          </div>
          <div class="pr-text">
            <p class="m">{p.data.model}</p>
            <p class="s">{p.data.series} series · {p.data.summary}</p>
          </div>
          <span class="go label-mono" aria-hidden="true">spec sheet</span>
        </a>
      </li>
    );
  })}
</ul>
<style>
  .prows { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .prows li { margin: 0; border-bottom: 1px solid var(--line); }
  .prows a {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5) 0;
    color: inherit; text-decoration: none;
  }
  @media (max-width: 42rem) {
    .prows a { grid-template-columns: 88px 1fr; gap: var(--space-4); }
    .prows .go { grid-column: 2; }
  }
  .prows a:hover .m { text-decoration: underline; text-decoration-color: var(--wet); text-underline-offset: 0.3em; }
  .ph { aspect-ratio: 1; background: var(--panel); border: 1px solid var(--line); overflow: hidden; display: grid; place-items: center; }
  .ph img { width: 100%; height: 100%; object-fit: cover; }
  .noimg { font-family: var(--font-mono); font-size: 0.65rem; color: var(--ink-2); text-align: center; padding: var(--space-2); letter-spacing: 0.04em; }
  .m { font-family: var(--font-mono); font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; margin: 0 0 var(--space-1); color: var(--ink); }
  .s { margin: 0; font-family: var(--font-serif); color: var(--ink-2); max-width: 60ch; }
  .go { color: var(--ink-2); white-space: nowrap; }
</style>
