---
import Base from '../layouts/Base.astro';
import HeroAir from '../components/HeroAir.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { families } from '../data/families';
import { productImage } from '../data/images';
import { site } from '../config/site';

const apps = (await getCollection('applications')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="ERV Singapore: fresh air, ERV and ceiling dehumidifiers | erv.sg"
  description="Ceiling dehumidifiers, fresh-air dehumidifiers and energy recovery ventilators for Singapore condos, landed homes and buildings. From DBA Electric, Aljunied Road."
>
  <!-- HERO: section drawing as the one memorable element -->
  <section class="hero wrap" aria-labelledby="hero-h">
    <div class="hero-meta">
      <span class="label-mono">Section A–A · condo bedroom · Singapore</span>
    </div>
    <HeroAir />
    <div class="hero-text">
      <h1 id="hero-h">Fresh air for your home, without Singapore's humidity</h1>
      <p class="lede">A unit hidden above the false ceiling brings in filtered outdoor air, takes the moisture out, and delivers it to each room through a small grille. Windows stay shut, rooms stay dry and don't get stuffy.</p>
      <div class="actions">
        <a class="btn" href="/contact/#quote">Request a quote</a>
        <a class="btn btn--quiet" href="/how-it-works/">How it works</a>
      </div>
    </div>
  </section>

  <!-- PROBLEM: three asymmetric paragraphs, not three identical cards -->
  <section class="section wrap">
    <div class="secthead">
      <div>
        <h2>Open the window and the room gets damp. Close it and the air gets stuffy</h2>
      </div>
    </div>
    <div class="problem">
      <div class="prob prob--a">
        <p class="label-mono">Fresh air only</p>
        <p>Outdoor air here is warm and wet all year. Bring it in untreated and the room gets damper; the aircon works harder; the bill goes up.</p>
      </div>
      <div class="prob prob--b">
        <p class="label-mono">Dehumidifier only</p>
        <p>A dehumidifier dries the air that's already in the room. In a sealed bedroom, that same air gets stale. CO₂ climbs. Sleep suffers.</p>
      </div>
      <div class="prob prob--c">
        <p class="label-mono">Both together, above the ceiling</p>
        <p>Pull filtered outdoor air in, recover cooling from the air going out, dry what comes in. Deliver it through the ceiling grille. No window needed.</p>
      </div>
    </div>
  </section>

  <!-- PRODUCT FAMILIES: three distinct asymmetric bands (no 01/02/03) -->
  <section class="section wrap">
    <div class="secthead">
      <div>
        <p class="eyebrow">Product families</p>
        <h2>Three types of unit, depending on what the room needs</h2>
      </div>
      <span class="ref">fig 01–03</span>
    </div>
    <ul class="families">
      {families.map((f, idx) => {
        const img = productImage(f.image);
        const flip = idx === 1;
        return (
          <li class={`fam ${flip ? 'fam--flip' : ''}`}>
            <div class="fam-visual">
              {img
                ? <figure>
                    <Image src={img} alt={f.imageAlt ?? f.name} widths={[360, 640]} sizes="(min-width: 56rem) 380px, 100vw" />
                    <figcaption><span class="fig">FIG {String(idx+1).padStart(2,'0')}</span>{f.name}</figcaption>
                  </figure>
                : <figure>
                    <div class="placeholder">PRODUCT · {f.name.toUpperCase()}</div>
                    <figcaption><span class="fig">FIG {String(idx+1).padStart(2,'0')}</span>{f.name} — photo pending</figcaption>
                  </figure>}
            </div>
            <div class="fam-text">
              <h3><a href={`/products/${f.slug}/`}>{f.name}</a></h3>
              <p>{f.intro}</p>
              <dl class="fam-facts">
                <dt>Where it goes</dt><dd>Above the false ceiling</dd>
                <dt>Used in</dt><dd>{f.goodFor}</dd>
              </dl>
              <p><a class="read-more" href={`/products/${f.slug}/`}>See the {f.name.toLowerCase()} range</a></p>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- APPLICATIONS: drawing-register list, no numbers -->
  <section class="section wrap">
    <div class="secthead">
      <div>
        <h2>Where they're used</h2>
      </div>
    </div>
    <ul class="register apps-reg">
      {apps.map((a) => (
        <li>
          <a href={`/applications/${a.id}/`}>
            <span class="title">{a.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- SPECIFIERS: asymmetric, no card -->
  <section class="section wrap specifier">
    <div class="spec-grid">
      <div>
        <p class="eyebrow label-mono">For specifiers</p>
        <h2>Datasheets, CAD files, and someone to read your floor plan</h2>
      </div>
      <div>
        <p>Trade terms for M&E consultants, contractors and interior designers working in Singapore. Send a floor plan and we'll return a sized schedule and the datasheets.</p>
        <p><a class="btn btn--quiet" href="/professionals/">Specifier resources</a></p>
      </div>
    </div>
  </section>

  <!-- TITLE-BLOCK STRIP: trust -->
  <section class="trust" aria-label="Company details">
    <div class="wrap trust-row">
      <div class="trust-cell">
        <span class="label-mono">Operator</span>
        <p><strong>{site.company.legalName}</strong></p>
      </div>
      <div class="trust-cell">
        <span class="label-mono">UEN</span>
        <p class="data">{site.company.uen}</p>
      </div>
      <div class="trust-cell">
        <span class="label-mono">Office</span>
        <p>{site.company.street}, Singapore</p>
      </div>
      <div class="trust-cell">
        <span class="label-mono">R290</span>
        <p><a href="/safety-compliance/">Safety and compliance</a></p>
      </div>
      <div class="trust-cell">
        <span class="label-mono">Off the shelf</span>
        <p><a href={site.sister.store.url} rel="noopener">{site.sister.store.name}</a></p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section wrap cta">
    <div class="cta-grid">
      <div>
        <p class="eyebrow label-mono">Next step</p>
        <h2>Send us your floor plan and we'll suggest what to install</h2>
      </div>
      <div class="cta-actions">
        <a class="btn" href="/contact/#quote">Request a quote</a>
        <a class="btn btn--quiet" href="/faq/">Read the FAQ</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO: drawing on top, text below, left-aligned */
  .hero { padding-block: var(--space-6) var(--space-8); display: grid; gap: var(--space-5); min-width: 0; }
  .hero > * { min-width: 0; max-width: 100%; }
  .hero-meta { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--line); padding-bottom: var(--space-2); }
  .hero-text { max-width: 54ch; }
  .hero h1 { max-width: 20ch; }
  .hero .lede { margin-bottom: 0; }
  .hero .actions { margin-top: var(--space-5); }

  /* PROBLEM: three columns, vertical rule between them; labels make the sequence clear */
  .problem { display: grid; gap: var(--space-6); border-top: 2px solid var(--rule); padding-top: var(--space-5); }
  @media (min-width: 56rem) { .problem { grid-template-columns: 1fr 1fr 1fr; gap: 0; } }
  .prob { padding: 0 var(--space-5); }
  .prob:first-child { padding-left: 0; }
  .prob:last-child { padding-right: 0; }
  @media (min-width: 56rem) {
    .prob + .prob { border-left: 1px solid var(--line); }
  }
  .prob p { max-width: 36ch; }
  .prob .label-mono { font-family: var(--font-sans); font-size: 1rem; font-weight: 600; letter-spacing: 0; color: var(--ink); margin-bottom: var(--space-3); }

  /* FAMILIES: asymmetric bands, alternating flip on the middle one */
  .families { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .fam { display: grid; gap: var(--space-5); padding-block: var(--space-7); border-bottom: 1px solid var(--line); margin: 0; }
  @media (min-width: 56rem) {
    .fam { grid-template-columns: 5fr 7fr; gap: var(--space-8); align-items: start; }
    .fam--flip { grid-template-columns: 7fr 5fr; }
    .fam--flip .fam-visual { order: 2; }
    .fam--flip .fam-text { order: 1; }
  }
  .fam-visual figure { margin: 0; }
  .fam-visual img { width: 100%; height: auto; display: block; background: var(--panel); border: 1px solid var(--line); }
  .fam-visual .placeholder { aspect-ratio: 4/3; }
  .fam-text h3 { font-size: var(--fs-h1); margin-bottom: var(--space-4); }
  .fam-text h3 a { color: var(--ink); text-decoration: none; background: linear-gradient(var(--rule), var(--rule)) 0 92%/0 1px no-repeat; transition: background-size .18s; }
  .fam-text h3 a:hover { background-size: 100% 1px; }
  .fam-facts { display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-5); margin: var(--space-5) 0; font-size: 0.95rem; }
  .fam-facts dt { font-family: var(--font-mono); font-size: var(--fs-meta); color: var(--ink-2); letter-spacing: 0.04em; padding-top: 0.25em; }
  .fam-facts dd { margin: 0; font-family: var(--font-serif); }
  .read-more { font-family: var(--font-sans); color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 0.3em; }
  .read-more:hover { text-decoration-color: var(--wet); }

  /* Apps register uses global .register */
  .apps-reg { border-top-color: var(--rule); border-top-width: 2px; }
  .apps-reg a { grid-template-columns: 1fr; }

  /* Specifier split */
  .spec-grid { display: grid; gap: var(--space-6); }
  @media (min-width: 56rem) { .spec-grid { grid-template-columns: 5fr 7fr; gap: var(--space-8); } }
  .spec-grid .eyebrow { margin: 0 0 var(--space-3); color: var(--ink-2); }
  .spec-grid h2 { max-width: 22ch; }

  /* Trust = architectural title block */
  .trust { background: var(--panel); border-block: 1px solid var(--rule); }
  .trust-row { display: grid; gap: var(--space-3) var(--space-6); padding-block: var(--space-5); grid-template-columns: 1fr; }
  @media (min-width: 42rem) { .trust-row { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .trust-row { grid-template-columns: repeat(5, 1fr); } }
  .trust-cell .label-mono { display: block; margin-bottom: 2px; }
  .trust-cell p { margin: 0; font-family: var(--font-serif); color: var(--ink); }
  .trust-cell a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line-strong); }

  /* CTA */
  .cta-grid { display: grid; gap: var(--space-5); border-top: 2px solid var(--rule); padding-top: var(--space-6); }
  @media (min-width: 56rem) { .cta-grid { grid-template-columns: 7fr 5fr; gap: var(--space-8); align-items: end; } }
  .cta-grid h2 { max-width: 22ch; margin: 0; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .cta-grid .eyebrow { margin: 0 0 var(--space-3); }
</style>
