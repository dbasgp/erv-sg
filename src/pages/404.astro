---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you were looking for isn't here." noindex>
  <section class="wrap page-head">
    <h1>Page not found</h1>
    <p class="lede">That page doesn't exist, or it has moved.</p>
    <div class="actions">
      <a class="btn" href="/products/">Browse products</a>
      <a class="btn btn--quiet" href="/">Home</a>
    </div>
  </section>
</Base>
