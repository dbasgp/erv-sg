---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const apps = (await getCollection('applications')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Applications: condos, landed homes, clinics, schools, labs and more"
  description="How fresh air and humidity control apply to Singapore condos, landed homes, clinics, schools, labs, hotels, offices and storage rooms."
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Applications', href: '/applications/' }]}
>
  <header class="wrap page-head">
    <h1>Where it's used</h1>
    <p class="lede">A sealed bedroom and an open clinic have different humidity and fresh-air problems, even in the same climate. Pick the space closest to your project.</p>
  </header>

  <section class="wrap">
    <ul class="register apps-reg">
      {apps.map((a) => (
        <li>
          <a href={`/applications/${a.id}/`}>
            <span class="title">{a.data.title}</span>
            <span class="meta">{a.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .apps-reg { border-top-color: var(--rule); border-top-width: 2px; }
  .apps-reg a { grid-template-columns: 16rem 1fr; }
  .apps-reg .meta { font-family: var(--font-serif); font-size: 1rem; letter-spacing: 0; }
  @media (max-width: 42rem) { .apps-reg a { grid-template-columns: 1fr; gap: var(--space-2); } .apps-reg .meta { grid-column: 1; font-family: var(--font-serif); } }
</style>
